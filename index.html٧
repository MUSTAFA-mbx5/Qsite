    function addNewCustomer(sectionType, shouldPrint = false) {
        const isPhone = sectionType === 'phones';
        const id = x => document.getElementById(isPhone ? 'phone'+x : 'device'+x);
        const seq=id('Seq').value.trim(), name=id('Name').value.trim(), phone=id('CustomerPhone').value.trim();
        const device=id(isPhone ? 'Type' : 'TypeName').value.trim();
        const total=parseFloat(id('TotalAmount').value.replace(/,/g,''));
        const monthly=parseFloat(id('Monthly').value.replace(/,/g,'')) || 0;
        const down=parseFloat(id('DownPayment').value.replace(/,/g,'')) || 0;
        const installments=monthly > 0 ? Math.ceil(Math.max(0, total-down) / monthly) : 0;
        const dateValue=id('DebtDate').value || todayInputValue();
        if(!seq || !name || !device || isNaN(total) || total <= 0) { alert('يرجى إكمال الاسم والتسلسل والجهاز وسعر التقسيط'); return; }
        if(down < 0 || down > total) { alert('المقدمة يجب ألا تتجاوز سعر التقسيط'); return; }
        const balance=total-down;
        const debtObj={ id:Date.now()+Math.random(), seq,name,phone,deviceType:device,totalAmount:total,downPayment:down,remaining:balance,monthlyPayment:monthly,installmentsRequired:installments || (monthly ? Math.ceil(balance/monthly) : 0),createdAt:new Date(dateValue+'T00:00:00').toISOString(),customerKey:phone?'phone:'+phone:'record:'+name+'|'+seq };
        if(isPhone) phonesDebts.push(debtObj); else devicesDebts.push(debtObj);
        addDebtTransaction(debtObj); if(down>0) paymentHistory.push({id:Date.now()+Math.random(),type:'مقدمة',customerPhone:phone,customerName:name,seq,device,amount:down,remaining:balance,date:new Date(dateValue+'T00:00:00').toISOString(),monthYear:monthKey(dateValue)});
        saveAllData(); renderAllModules();
        if(shouldPrint) printA5ReceiptDirect(name,phone,down,balance,seq,device,'دين - مع مقدمة',new Date(dateValue+'T00:00:00'));
        clearCustomerForm(sectionType); alert(shouldPrint?'تم الحفظ والطباعة وتفريغ الحقول بنجاح!':'تم الحفظ وتفريغ الحقول بنجاح!');
    }

