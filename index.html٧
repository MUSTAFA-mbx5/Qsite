    function renderStatsModule() {
        let monthPicker = document.getElementById("statsMonthPicker");
        if(!monthPicker.value) { const now = new Date(); monthPicker.value = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2, '0')}`; }
        const allDebts = [...phonesDebts.map(d=>({...d, section:'phones'})), ...devicesDebts.map(d=>({...d, section:'devices'}))];
        const totalSales = allDebts.reduce((s,d)=>s+(Number(d.totalAmount)||0),0);
        const totalPaid = allDebts.reduce((s,d)=>s+(Number(d.totalAmount)||0)-(Number(d.remaining)||0),0);
        const totalRemaining = allDebts.reduce((s,d)=>s+(Number(d.remaining)||0),0);
        const paidCount = allDebts.filter(d=>d.remaining<=0).length;
        const unpaidCount = allDebts.filter(d=>d.remaining>0).length;
        const lateCount = allDebts.filter(d=>d.remaining>0 && overdueMonths(d)>0).length;
        document.getElementById("statTotalSales").textContent = totalSales.toLocaleString() + " د.ع";
        document.getElementById("statTotalPaid").textContent = totalPaid.toLocaleString() + " د.ع";
        document.getElementById("statTotalRemaining").textContent = totalRemaining.toLocaleString() + " د.ع";
        document.getElementById("statPaidCount").textContent = paidCount;
        document.getElementById("statUnpaidCount").textContent = unpaidCount;
        document.getElementById("statLateCount").textContent = lateCount;
        document.getElementById("statCustomersCount").textContent = new Set(allDebts.map(d=>d.phone)).size;
        const cat = document.getElementById('statsCategoryFilter')?.value || 'all';
        const status = document.getElementById('statsStatusFilter')?.value || 'all';
        const filtered = allDebts.filter(d => (cat==='all'||d.section===cat) && (status==='all' || (status==='paid'&&d.remaining<=0) || (status==='unpaid'&&d.remaining>0) || (status==='late'&&d.remaining>0&&overdueMonths(d)>0)));
        document.getElementById('monthlyCustomersContainer').innerHTML = filtered.length ? filtered.map(d=>`<div class="border rounded-xl p-3 flex flex-wrap justify-between gap-2 text-sm"><div><b>${d.name}</b> <span class="text-xs text-slate-500">${d.section==='phones'?'موبايلات':'أجهزة كهربائية'} - ${d.deviceType}</span><div class="text-xs text-slate-500">التاريخ: ${formatDate(d.createdAt)} | التسلسل: ${d.seq||'---'}</div></div><div class="text-left"><div class="font-bold ${d.remaining<=0?'text-green-600':'text-red-600'}">${d.remaining<=0?'مسدد بالكامل':'متبقي: '+Number(d.remaining).toLocaleString()+' د.ع'}</div><div class="text-xs ${overdueMonths(d)>0?'text-rose-600':'text-slate-500'}">${d.remaining>0 ? (overdueMonths(d)>0 ? `متأخر ${overdueMonths(d)} شهر` : 'غير متأخر') : 'تم التسديد'}</div></div></div>`).join('') : '<p class="text-center text-slate-400 py-6 font-bold">لا توجد نتائج بهذا الفرز</p>';
    }

