                <div class="grid grid-cols-3 gap-2 mb-4 bg-blue-50 p-3 rounded-xl text-xs"><label class="font-bold">رقم التسلسل<input id="detailSeq" value="${custItems[0].seq||''}" class="w-full border rounded p-2 mt-1"></label><label class="font-bold">اسم الزبون<input id="detailName" value="${String(custItems[0].name||'').replace(/"/g,'&quot;')}" class="w-full border rounded p-2 mt-1"></label><label class="font-bold">رقم الهاتف<input id="detailPhone" value="${custItems[0].phone||''}" class="w-full border rounded p-2 mt-1"></label></div>
                <h4 class="font-bold text-sm mb-2 text-blue-700">الأجهزة المسجلة وتعديل مبالغها:</h4>
                <div class="mb-4">${itemsHtml}</div>

