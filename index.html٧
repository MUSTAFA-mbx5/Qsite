        <div class="receipt-box"><h2 style="font-size:15px;font-weight:900;margin:0 0 8px">جدول التسديد</h2><table style="width:100%;border-collapse:collapse;font-size:11px"><thead><tr style="background:#e5e7eb"><th style="border:1px solid #222;padding:6px">التاريخ</th><th style="border:1px solid #222;padding:6px">التسديد</th><th style="border:1px solid #222;padding:6px">الدين</th><th style="border:1px solid #222;padding:6px">ملاحظات</th></tr></thead><tbody>${rows.map(h=>{const paid=h.type==='تسديد';return `<tr><td style="border:1px solid #222;padding:6px;background:${paid?'#dcfce7':'#fee2e2'}">${transactionDate(h.date).toLocaleDateString('en-CA')}</td><td style="border:1px solid #222;padding:6px">${paid?Number(h.amount||0).toLocaleString()+' د.ع':''}</td><td style="border:1px solid #222;padding:6px">${!paid?Number(h.amount||0).toLocaleString()+' د.ع':''}</td><td style="border:1px solid #222;padding:6px">${h.note||''}</td></tr>`}).join('')}</tbody></table></div></div>`;
        setTimeout(() => { applyReceiptPrintSize(); window.print(); setTimeout(() => { printArea.innerHTML=''; printArea.className='hidden'; }, 800); }, 250);
    }

    function saveCustomerDetailsEdits(customerKey, modal) {
        const all = [...phonesDebts, ...devicesDebts];
        const items = all.filter(d => (d.customerKey || (d.phone ? 'phone:'+d.phone : 'record:'+d.name+'|'+d.seq)) === customerKey);
        if (!items.length) return;
        const oldInfo = items.map(d => ({phone:d.phone || '', device:d.deviceType, name:d.name}));
        const seq = modal.querySelector('#detailSeq').value.trim();
        const name = modal.querySelector('#detailName').value.trim();
        const phone = modal.querySelector('#detailPhone').value.trim();
        if (!seq || !name) { alert('التسلسل والاسم مطلوبان'); return; }
        items.forEach((item, index) => {
            item.seq = seq; item.name = name; item.phone = phone;
            const box = modal.querySelector(`[data-detail-item="${item.id}"]`);
            if (box) {
                const val = key => box.querySelector(`[data-item-field="${key}"]`).value;
                item.deviceType = val('deviceType').trim();
                item.totalAmount = Number(val('totalAmount').replace(/,/g,'')) || 0;
                item.downPayment = Number(val('downPayment').replace(/,/g,'')) || 0;
                item.monthlyPayment = Number(val('monthlyPayment').replace(/,/g,'')) || 0;
                item.installmentsRequired = Number(val('installmentsRequired')) || 0;
                item.remaining = Number(val('remaining').replace(/,/g,'')) || 0;
                if (item.remaining > item.totalAmount || item.downPayment > item.totalAmount) throw new Error('المبالغ غير صحيحة');
            }
            item.customerKey = phone ? 'phone:'+phone : 'record:'+name+'|'+seq;
        });
        const oldSet = new Set(oldInfo.map(x => x.phone+'|'+x.device));
        paymentHistory.forEach(h => { if (oldSet.has((h.customerPhone||'')+'|'+h.device)) { h.customerPhone=phone; h.customerName=name; h.seq=seq; } });
        modal.querySelectorAll('[data-history-id]').forEach(row => {
            const h = paymentHistory.find(x => String(x.id) === String(row.dataset.historyId));
            if (!h) return;
            const paid = Number(row.querySelector('[data-history-field="paid"]').value.replace(/,/g,'')) || 0;
            const debt = Number(row.querySelector('[data-history-field="debt"]').value.replace(/,/g,'')) || 0;
            h.amount = paid > 0 ? paid : debt;
            h.type = paid > 0 ? 'تسديد' : 'دين';
            h.note = row.querySelector('[data-history-field="note"]').value.trim();
            const d = row.querySelector('[data-history-field="date"]').value;
            if (d) h.date = new Date(d+'T00:00:00').toISOString();
            h.monthYear = monthKey(h.date);
        });
        saveAllData(); renderAllModules(); modal.remove(); alert('تم حفظ تعديل الاسم والتسلسل والهاتف والأجهزة والمبالغ وجدول الدفعات بنجاح.');
    }

