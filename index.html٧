        const rows = paymentHistory.filter(h => h.customerPhone === (customer.phone || '') && deviceSet.has(h.device)).sort((a,b)=>transactionDate(b.date)-transactionDate(a.date));
        const totalDebt = customerItems.reduce((sum,d)=>sum+Number(d.totalAmount||0),0);
        const remaining = customerItems.reduce((sum,d)=>sum+Number(d.remaining||0),0);
        const paid = Math.max(0,totalDebt-remaining);
        const last = rows[rows.length-1];
        const operationDate = last ? transactionDate(last.date) : transactionDate(customer.createdAt);
        const printArea = document.getElementById('printArea');
        printArea.className = 'receipt-template history-print-full'; const receiptShapeClass = prepareReceiptPageFrame(printArea, getReceiptShapeNumber());
        printArea.innerHTML = `<div class="${receiptShapeClass}"><div class="receipt-head"><div><h1 style="font-size:20px;font-weight:900;margin:0">محل وليد</h1><p style="margin:4px 0;font-size:11px">تفاصيل السجل</p><p style="font-size:10px;font-weight:bold">كود الوصل: #HISTORY-${Date.now()}</p></div><img class="receipt-logo" src="${appLogoUrl}"></div>
