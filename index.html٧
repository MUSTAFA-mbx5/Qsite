        document.querySelectorAll(".price-input").forEach(input => {
            input.addEventListener('input', () => normalizeMoneyInput(input));
            input.addEventListener('paste', () => setTimeout(() => normalizeMoneyInput(input), 0));
            input.addEventListener('blur', function() {
                normalizeMoneyInput(this);
                if (!autoAddZeros || !this.value) return;
                const val = this.value.replace(/,/g, '').trim();
                const num = Number(val);
                // الإدخال المختصر بالدينار: 1200 تصبح 1,200,000 عند تفعيل الخيار.
                if (Number.isFinite(num) && num > 0 && num < 1000000) {
                    this.value = Math.round(num * 1000).toLocaleString('en-US');
                } else if (Number.isFinite(num)) {
                    this.value = num.toLocaleString('en-US');
                }
            });
        });
        // الحقول المضافة ديناميكيًا أو غير الموسومة تبقى قابلة للتحويل عند الإدخال.
        document.querySelectorAll('input[type="text"], input[type="number"]').forEach(input => {
