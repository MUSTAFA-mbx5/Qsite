            ${receiptContent}
            <div class="receipt-barcode"><div id="receiptSquareBarcode" style="display:inline-block"></div><div style="font-size:10px;margin-top:3px;font-weight:bold">كود الوصل: ${code}</div></div><p style="text-align:center;font-size:11px;margin-top:12px">شكراً لتعاملكم معنا</p></div>`;
