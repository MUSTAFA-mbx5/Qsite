    function printCustomerTransactionHistory(customerKey) {
        const all = [...phonesDebts, ...devicesDebts];
        const customerItems = all.filter(d => (d.customerKey || (d.phone ? 'phone:'+d.phone : 'record:'+d.name+'|'+d.seq)) === customerKey);
