        document.getElementById('statsStatusFilter').onchange = renderStatsModule;
        document.getElementById('statsMonthPicker').onchange = renderStatsModule;
        document.getElementById('printStatsBtn').onclick = () => { const area=document.getElementById('printArea'); area.className='receipt-template ' + getReceiptStyleClass() + ' ' + getReceiptPaperClass(); area.innerHTML='<h2>سجل الإحصائية</h2>'+document.getElementById('monthlyCustomersContainer').innerHTML; setTimeout(()=>{applyReceiptPrintSize();window.print();setTimeout(()=>{area.innerHTML="";area.className="hidden"},700)},200); };

        document.getElementById("backupNowBtn").onclick = () => {
            let jsonStr = JSON.stringify({
                systemPin, autoAddZeros, phonesDebts, devicesDebts, inventory, paymentHistory, activeWarranties, botSettings, receiptDesign, receiptDesigns, appLogoUrl
            }, null, 2);
            let blob = new Blob([jsonStr], { type: 'application/json' });
            let a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `walid_system_backup_${Date.now()}.json`;
            a.click();
        };

        document.getElementById("restoreBackupBtn").onclick = () => {
            document.getElementById("restoreFileInput").click();
        };

        document.getElementById("restoreFileInput").onchange = (e) => {
            let file = e.target.files[0];
            if(file) {
                let reader = new FileReader();
                reader.onload = function(evt) {
                    try {
                        let data = JSON.parse(evt.target.result);
                        if(data.phonesDebts) phonesDebts = data.phonesDebts;
                        if(data.devicesDebts) devicesDebts = data.devicesDebts;
                        if(data.inventory) inventory = data.inventory;
                        if(data.paymentHistory) paymentHistory = data.paymentHistory;
                        if(data.activeWarranties) activeWarranties = data.activeWarranties;
                        if(data.botSettings) botSettings = data.botSettings;
                        if(data.receiptDesign) receiptDesign = data.receiptDesign;
                        if(data.receiptDesigns) receiptDesigns = data.receiptDesigns;
                        if(data.appLogoUrl) appLogoUrl = data.appLogoUrl;
                        
                        saveAllData();
                        alert("تمت استعادة النسخة الاحتياطية بنجاح!");
                        location.reload();
                    } catch(err) {
                        alert("ملف غير صالح!");
                    }
                };
                reader.readAsText(file);
            }
        };

        document.getElementById("wipeAllDataBtn").onclick = async () => {
            const ok = confirm("تحذير مهم: سيتم حذف جميع الزبائن والمخزن والدفعات والتصميم نهائياً. هل تريد المتابعة؟");
            if (!ok) return;
            const saveFirst = confirm("هل تريد حفظ نسخة احتياطية قبل التصفير؟ اضغط موافق للحفظ ثم التصفير، أو إلغاء لإلغاء العملية.");
            if (saveFirst) {
                const backup = { systemPin, autoAddZeros, phonesDebts, devicesDebts, inventory, paymentHistory, activeWarranties, botSettings, receiptDesign, receiptDesigns, appLogoUrl, timestamp: new Date().toISOString() };
                const blob = new Blob([JSON.stringify(backup, null, 2)], { type: "application/json" });
                const a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = `walid_before_reset_${Date.now()}.json`; a.click();
                await new Promise(resolve => setTimeout(resolve, 150));
            }
            localStorage.clear();
            alert("تم تصفير النظام. سيعاد فتحه بالبيانات الافتراضية.");
            location.reload();
        };

        window.addEventListener("beforeunload", (event) => {
            if (hasUnsavedChanges) {
                event.preventDefault();
                event.returnValue = "لديك تغييرات غير محفوظة. هل تريد حفظ نسخة قبل المغادرة؟";
            }
        });
    };
</script>
</body>
</html>
