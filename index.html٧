    function normalizeArabicDigits(value) {
        return String(value ?? '')
            .replace(/[٠-٩]/g, ch => String(ch.charCodeAt(0) - 0x0660))
            .replace(/[۰-۹]/g, ch => String(ch.charCodeAt(0) - 0x06F0))
            .replace(/[٬،]/g, ',')
            .replace(/[٫]/g, '.');
    }
