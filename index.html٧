    function monthKey(date) { const d = new Date(date || Date.now()); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`; }
    function addMonthsDate(date, months) { const d = new Date(date || Date.now()); d.setMonth(d.getMonth()+months); return d; }
    function missedInstallments(debt) {
        if (!debt || Number(debt.remaining||0) <= 0) return 0;
        const start = new Date(debt.createdAt || Date.now());
        const due = addMonthsDate(start, 1);
        const now = new Date();
        if (now < due) return 0;
        const payments = paymentHistory.filter(h => h.customerPhone === debt.phone && h.device === debt.deviceType && h.type === 'تسديد');
        const paidMonths = new Set(payments.map(h => monthKey(h.date)));
        let missed = 0;
        const cursor = new Date(due);
        while (cursor <= now) { if (!paidMonths.has(monthKey(cursor))) missed++; cursor.setMonth(cursor.getMonth()+1); }
        return missed;
    }

    function renderCustomersModule(sectionType) {
        let isPhone = sectionType === 'phones';
        let listContainer = document.getElementById(isPhone ? "phonesDebtorsList" : "devicesDebtorsList");
        let searchVal = normalizeArabicDigits((document.getElementById(isPhone ? "searchPhonesInput" : "searchDevicesInput").value || "").trim().toLowerCase());
        let debts = isPhone ? phonesDebts : devicesDebts;

        listContainer.innerHTML = "";

        let grouped = {};
        debts.forEach(d => {
            d.customerKey = d.customerKey || (d.phone ? 'phone:' + d.phone : 'record:' + d.name + '|' + d.seq);
            if(!grouped[d.customerKey]) {
                grouped[d.customerKey] = { key: d.customerKey, name: d.name, phone: d.phone || '', seq: d.seq, items: [] };
            }
            grouped[d.customerKey].items.push(d);
        });

        const statusFilter = document.getElementById(isPhone ? 'phoneStatusFilter' : 'deviceStatusFilter')?.value || 'all';
        const searchTokens = searchVal.split(/\s+/).filter(Boolean);
        const exactToken = (value, query) => String(value || '').toLowerCase().split(/\s+/).some(token => token === query);
        const numericSearch = /^\d+$/.test(searchVal);
        const resultPriority = c => {
            if (!searchTokens.length) return 0;
            const words = c.name.toLowerCase().split(/\s+/);
            const wordIndex = words.findIndex(w => searchTokens.every(q => w === q));
            if (wordIndex >= 0) return wordIndex;
            if (exactToken(c.seq, searchVal)) return 0;
            if (exactToken(c.phone, searchVal)) return 0;
            if (c.items.some(i => exactToken(i.deviceType, searchVal))) return 3;
            return 9;
        };
        let filtered = Object.values(grouped).filter(c => {
            const rem = c.items.reduce((sum, i) => sum + Number(i.remaining || 0), 0);
            const late = c.items.some(i => Number(i.remaining||0) > 0 && missedInstallments(i) > 0);
            const statusOk = statusFilter === 'all' || (statusFilter === 'paid' && rem <= 0) || (statusFilter === 'unpaid' && rem > 0) || (statusFilter === 'late' && late);
            const nameMatch = searchTokens.length > 0 && searchTokens.every(q => c.name.toLowerCase().split(/\s+/).includes(q));
            const seqMatch = numericSearch ? Number(c.seq) === Number(searchVal) : (searchTokens.length > 0 && searchTokens.every(q => exactToken(c.seq, q)));
            const phoneMatch = searchTokens.length > 0 && searchTokens.every(q => exactToken(c.phone, q));
            const deviceMatch = searchTokens.length > 0 && c.items.some(i => searchTokens.every(q => i.deviceType.toLowerCase().split(/\s+/).includes(q)));
            return statusOk && (!searchTokens.length || nameMatch || seqMatch || phoneMatch || deviceMatch);
        }).sort((a,b) => resultPriority(a) - resultPriority(b) || a.name.localeCompare(b.name, 'ar'));

        if(filtered.length === 0) {
            listContainer.innerHTML = "<p class='text-center text-gray-500 py-6 font-bold'>لا يوجد زبائن مطايقين للبحث</p>";
            return;
        }

        filtered.forEach(cust => {
            let totalRem = cust.items.reduce((s, i) => s + i.remaining, 0);
            let devicesText = cust.items.map(i => `${i.deviceType} (متبقي: ${i.remaining.toLocaleString()})`).join(' ، ');

            let card = document.createElement("div");
            card.className = "bg-white border p-4 rounded-xl shadow-sm flex flex-col gap-3";
            card.innerHTML = `
                <div class="flex justify-between items-center flex-wrap gap-2">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="bg-blue-600 text-white font-mono text-xs px-2 py-0.5 rounded font-bold">${cust.seq || '---'}</span>
                            <strong class="text-base text-gray-900">${cust.name}</strong>
                            <span class="text-xs text-gray-500 font-mono">${cust.phone ? '📞 ' + cust.phone : 'بدون هاتف'}</span>
                        </div>
                        <p class="text-xs text-gray-600 mt-1">الأجهزة: ${devicesText}</p>
                    </div>
                    <div class="text-left">
                        <p class="text-xs text-gray-500">إجمالي المتبقي</p>
                        <p class="text-lg font-black text-red-600">${totalRem.toLocaleString()} د.ع</p>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2 border-t pt-2">
                    <button onclick="sendWhatsAppReminder('${cust.name}', '${cust.phone}', ${totalRem})" class="btn-whatsapp card-btn bg-green-600 text-white border-green-700"><i class="fab fa-whatsapp"></i> تذكير بالدين</button>
                    <button onclick="openPaymentModal('${cust.key}')" class="btn-pay card-btn bg-blue-600 text-white border-blue-700"><i class="fas fa-hand-holding-usd"></i> تسديد</button>
                    <button onclick="openAddDeviceToCustModal('${cust.key}')" class="btn-purple card-btn text-white"><i class="fas fa-plus-circle"></i> إضافة جهاز جديد</button>
                    <button onclick="openCustomerDetailsModal('${cust.key}')" class="btn-details card-btn bg-slate-100 border-slate-300 text-slate-800"><i class="fas fa-info-circle"></i> التفاصيل</button>
