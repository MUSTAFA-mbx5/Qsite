    function todayInputValue() { return new Date().toISOString().slice(0, 10); }
    function clearCustomerForm(sectionType) {
        const ids = sectionType === 'phones' ? ['phoneSeq','phoneName','phoneCustomerPhone','phoneType','phoneTotalAmount','phoneMonthly','phoneDownPayment','phoneInstallments'] : ['deviceSeq','deviceName','deviceCustomerPhone','deviceTypeName','deviceTotalAmount','deviceMonthly','deviceDownPayment','deviceInstallments'];
