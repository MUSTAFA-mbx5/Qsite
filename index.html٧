        const selected = localStorage.getItem('walid_receipt_template') || 'style-1';
        const n = Math.max(1, Math.min(5, parseInt(String(selected).replace('style-','')) || 1));
        const offset = size === 'A4' ? 0 : size === 'A6' ? 10 : 5;
        return 'receipt-style-' + (offset + n);
    }
    function refreshTemplateOptions() {
        const sel = document.getElementById('receiptTemplateSelect'); if (!sel) return;
        const size = localStorage.getItem('walid_receipt_size') || 'A5';
        const offset = size === 'A4' ? 0 : size === 'A6' ? 10 : 5;
        sel.innerHTML = '';
        for (let i=1;i<=5;i++) { const opt=document.createElement('option'); opt.value='style-'+(offset+i); opt.textContent='تصميم '+i+' - '+size; sel.appendChild(opt); }
        const current = localStorage.getItem('walid_receipt_template') || ('style-'+(offset+1));
        sel.value = current; if (sel.value !== current) { sel.value='style-'+(offset+1); localStorage.setItem('walid_receipt_template',sel.value); }
    }

    function getReceiptPaperClass() {
        const size = localStorage.getItem('walid_receipt_size') || 'A5';
        return size === 'A4' ? 'receipt-size-a4' : size === 'A6' ? 'receipt-size-a6' : 'receipt-size-a5';
    }

    function getReceiptShapeNumber() {
        const selected = localStorage.getItem('walid_receipt_template') || 'style-1';
        const size = localStorage.getItem('walid_receipt_size') || 'A5';
        const offset = size === 'A4' ? 0 : size === 'A6' ? 10 : 5;
        return Math.max(1, Math.min(5, (parseInt(String(selected).replace('style-','')) || 1) - offset));
    }
    function prepareReceiptPageFrame(printArea, shapeNumber) {
        const paperSize = localStorage.getItem('walid_receipt_size') || 'A5';
        printArea.classList.add('receipt-page-frame','receipt-layout-' + paperSize.toLowerCase());
        printArea.classList.remove('receipt-size-a4','receipt-size-a5','receipt-size-a6');
        printArea.classList.add(getReceiptPaperClass());
        printArea.style.setProperty('--receipt-page-height', ({A4:'297mm',A5:'210mm',A6:'105mm'}[paperSize]));
        return 'receipt-shape receipt-shape-' + shapeNumber;
    }

