<div id="printArea" class="hidden"></div>

<script>
    // -------------------------------------------------------------------------
    // 1. البيانات المتغيرات العامة والحالة
    // -------------------------------------------------------------------------
    let systemPin = "2001";
    let autoAddZeros = false;
    let phonesDebts = [];
    let devicesDebts = [];
    let inventory = [];
    let paymentHistory = [];
    let activeWarranties = [];
    let botSettings = { token: "", chatId: "", extraChatIds: "" };
    let receiptDesign = null;
    let receiptDesigns = {};
    let activeDesignKey = 'A5-style-1';
    let appLogoUrl = "https://via.placeholder.com/80?text=Qsite";

    let hasUnsavedChanges = false;
    let autoBackupTimer = null;
    let selectedPosProduct = null;
    let currentPayCustomerPhone = null;
    let currentAddDevCustomerPhone = null;

    // -------------------------------------------------------------------------
    // 2. تحميل وحفظ البيانات
    // -------------------------------------------------------------------------
    function saveAllData() {
        localStorage.setItem("walid_system_pin", systemPin);
        localStorage.setItem("walid_auto_zeros", JSON.stringify(autoAddZeros));
        localStorage.setItem("walid_phones_debts", JSON.stringify(phonesDebts));
        localStorage.setItem("walid_devices_debts", JSON.stringify(devicesDebts));
        localStorage.setItem("walid_inventory", JSON.stringify(inventory));
        localStorage.setItem("walid_payment_history", JSON.stringify(paymentHistory));
        localStorage.setItem("walid_active_warranties", JSON.stringify(activeWarranties));
        localStorage.setItem("walid_bot_settings", JSON.stringify(botSettings));
        localStorage.setItem("walid_app_logo", appLogoUrl);
        if(receiptDesign) localStorage.setItem("walid_receipt_design", JSON.stringify(receiptDesign));
        localStorage.setItem("walid_receipt_designs", JSON.stringify(receiptDesigns));

        hasUnsavedChanges = true;
    }

    function loadAllData() {
        systemPin = localStorage.getItem("walid_system_pin") || "2001";
        autoAddZeros = JSON.parse(localStorage.getItem("walid_auto_zeros") || "false");
        phonesDebts = JSON.parse(localStorage.getItem("walid_phones_debts")) || [];
        devicesDebts = JSON.parse(localStorage.getItem("walid_devices_debts")) || [];
        inventory = JSON.parse(localStorage.getItem("walid_inventory")) || [];
        paymentHistory = JSON.parse(localStorage.getItem("walid_payment_history")) || [];
        activeWarranties = JSON.parse(localStorage.getItem("walid_active_warranties")) || [];
        botSettings = JSON.parse(localStorage.getItem("walid_bot_settings")) || { token: "", chatId: "", extraChatIds: "" };
        appLogoUrl = localStorage.getItem("walid_app_logo") || "https://via.placeholder.com/80?text=Qsite";
        receiptDesign = JSON.parse(localStorage.getItem("walid_receipt_design")) || getDefaultReceiptDesign();
        receiptDesigns = JSON.parse(localStorage.getItem("walid_receipt_designs") || '{}');
        if (!Object.keys(receiptDesigns).length) receiptDesigns['A5-style-1'] = { data: receiptDesign, bg:'#ffffff', border:'#1e3a8a', motion:true };
        [...phonesDebts, ...devicesDebts].forEach(d => { if (!d.customerKey) d.customerKey = d.phone ? 'phone:' + d.phone : 'record:' + d.name + '|' + d.seq; });

        // ترحيل الديون القديمة إلى سجل المعاملات مرة واحدة بدون تكرار.
        [...phonesDebts, ...devicesDebts].forEach(debt => {
            const exists = paymentHistory.some(h => h.type === 'دين' && h.customerPhone === debt.phone && h.device === debt.deviceType);
            if (!exists) {
                paymentHistory.push({ id: 'legacy-debt-' + debt.id, type: 'دين', customerPhone: debt.phone, customerName: debt.name, seq: debt.seq, device: debt.deviceType, amount: debt.totalAmount, remaining: debt.remaining, date: debt.createdAt || new Date().toISOString(), monthYear: new Date(debt.createdAt || Date.now()).toISOString().slice(0,7) });
            }
        });

        document.getElementById("autoAddZerosToggle").checked = autoAddZeros;
        document.getElementById("botToken").value = botSettings.token;
        document.getElementById("chatId").value = botSettings.chatId;
        document.getElementById("extraChatId").value = botSettings.extraChatIds;
        document.getElementById("headerLogo").src = appLogoUrl;
        const templateSelect = document.getElementById('receiptTemplateSelect');
        if (templateSelect) { refreshTemplateOptions(); templateSelect.onchange = e => localStorage.setItem('walid_receipt_template', e.target.value); }
        const themeSelect = document.getElementById('themeSelect'); if (themeSelect) { const th=localStorage.getItem('walid_theme')||'official'; themeSelect.value=th; document.body.className='p-2 md:p-6 theme-'+th; themeSelect.onchange=e=>{ localStorage.setItem('walid_theme',e.target.value); document.body.className='p-2 md:p-6 theme-'+e.target.value; }; }
        const paperSizeSelect = document.getElementById('receiptPaperSizeSelect');
        if (paperSizeSelect) paperSizeSelect.value = localStorage.getItem('walid_receipt_size') || 'A5';

        setupPriceInputsAutoZeros();
        setupAutoBackupSystem();
    }

    // -------------------------------------------------------------------------
    // 3. أمان الدخول وغلق النظام الآلي مع الحفظ
    // -------------------------------------------------------------------------
    function initLoginGuard() {
        document.getElementById("loginBtn").onclick = () => {
            if(document.getElementById("pinInput").value === systemPin) {
                document.getElementById("loginScreen").classList.add("hidden");
                document.getElementById("pinInput").value = "";
                sendTelegramNotification("🔔 تم تسجيل الدخول للنظام بنجاح.");
                renderAllModules();
            } else {
                document.getElementById("loginError").classList.remove("hidden");
            }
        };

        document.getElementById("lockSystemBtn").onclick = async () => {
            if(hasUnsavedChanges) {
                await executeSmartBackup();
            }
            sendTelegramNotification("🔴 تم إغلاق النظام.");
            document.getElementById("loginScreen").classList.remove("hidden");
        };

        document.getElementById("changePinBtn").onclick = () => {
            let p = document.getElementById("newPinInput").value.trim();
            if(p.length >= 4) { systemPin = p; saveAllData(); alert("تم تغيير الرمز بنجاح!"); document.getElementById("newPinInput").value = ""; }
        };

        document.getElementById("specialBtn").onclick = () => { const el=document.getElementById('liveDateTime'); if(el) el.textContent = formatDateTime(new Date()); };

        document.getElementById("checkGithubUpdateBtn").onclick = () => {
            if(navigator.onLine) {
                alert("الإصدار سليم ومحدث تلقائياً مع المستودع الرسمي (1.0.0).");
            } else {
                alert("الإصدار سليم، النظام يعمل بوضع المحتفظ المحلي (Offline).");
            }
        };
    }

    // -------------------------------------------------------------------------
    // 4. النسخ الاحتياطي التلقائي والذكاء عند التغييرات
    // -------------------------------------------------------------------------
    function setupAutoBackupSystem() {
        let select = document.getElementById("backupIntervalSelect");
        
        function resetTimer() {
            if(autoBackupTimer) clearInterval(autoBackupTimer);
            let mins = parseFloat(select.value);
            autoBackupTimer = setInterval(() => {
                if(hasUnsavedChanges) {
                    executeSmartBackup();
                }
            }, mins * 60 * 1000);
        }

        select.onchange = resetTimer;
