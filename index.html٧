                </table>
                <div class="grid grid-cols-3 gap-2 mt-4"><button onclick="saveCustomerDetailsEdits('${phone}', this.closest('.loading-overlay'))" class="btn-success py-2 rounded-xl"><i class="fas fa-save"></i> حفظ كل التعديلات</button><button onclick="printCustomerTransactionHistory('${phone}')" class="btn-primary py-2 rounded-xl"><i class="fas fa-print"></i> طباعة السجل</button><button onclick="this.closest('.loading-overlay').remove()" class="btn-secondary py-2 rounded-xl">إغلاق</button></div>
